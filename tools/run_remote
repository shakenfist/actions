#!/bin/bash

# $1 is the target machine
# $2+ is the command

# ${@:2} is deliberately unquoted on both local branches. Almost every
# caller passes the remote command as a single string -- for example
# `tools/run_remote ${primary} "sudo bash tools/ci_drain_check.sh"` --
# and relies on word splitting to turn it into an argv. Quoting it makes
# argv[0] the whole string and exec fails with "No such file or
# directory". This matches the deliberately unquoted ssh invocation at
# the bottom of this file, which exists for the same reason.
# shellcheck disable=SC2068
if [ "${1}" == "localhost" ]; then
    exec ${@:2}
fi

# shellcheck disable=SC2068
if [ "${1}" == "$(hostname)" ]; then
    exec ${@:2}
fi

if [ -z "${baseuser}" ]; then
    baseuser="debian"
fi

script=${2}
if [ "%${copyscript}%" == "%true%" ]; then
    script="/tmp/$(basename "${2}")"
    echo "Copying ${2} to ${script} on ${1}"
    scp -p -i /srv/github/id_ci -o StrictHostKeyChecking=no \
        -o UserKnownHostsFile=/dev/null \
        "${2}" "${baseuser}@${1}:${script}"
fi

# ${*:3} rather than ${@:3} in the message: the arguments are being
# described here, not passed on, and "${@:3}" inside a larger string
# expands to a mangled join of the first and last elements (SC2145).
echo "Executing ${script} ${*:3} on ${1}"

# ${script} is deliberately unquoted. It may carry arguments baked into
# it by callers, and ssh concatenates its argv into one remote command
# string anyway, so word splitting here is the intended behaviour.
# shellcheck disable=SC2086
ssh -i /srv/github/id_ci -o StrictHostKeyChecking=no \
    -o UserKnownHostsFile=/dev/null \
    "${baseuser}@${1}" ${script} "${@:3}"
